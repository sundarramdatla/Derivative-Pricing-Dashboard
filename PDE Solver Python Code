plt.xlabel("Stock Price ($)")
plt.ylabel(f"European {OptionType} Option Price ($)")
plt.title(f"European {OptionType}: Finite Difference vs Black-Scholes")
plt.legend()
plt.grid(alpha=0.3)
plt.show()

