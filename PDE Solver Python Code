import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import norm


OptionType = "Call"
K = 110
T = 1
S_max = K * 3  
S_nodes = 100
T_nodes = 100
r = 0.05
vol = 0.20
S = np.linspace(0,S_max, S_nodes)
t = np.linspace(0,T, T_nodes)
ds = S[1] - S[0]
dt_max = 1/((vol**2)*((S_nodes-2)**2)+r)
T_nodes = int(np.ceil(T / (0.9 * dt_max))) + 1
i_min = 1
i_max = S_nodes - 1

B_up = 200
B_down = 80

t = np.linspace(0, T, T_nodes)
dt = t[1] - t[0]

V = np.zeros((t.size, S.size))

if OptionType == "Put":
    V[-1,:] = np.maximum(K-S, 0) #Put option boundary conditions
    V[:,0] = K*np.exp(-r*(T-t))
    V[:,-1] = 0
elif OptionType =="Call":
    V[-1,:] = np.maximum(S - K, 0)
    V[:,0] = 0
    V[:, -1] = S_max - K*np.exp(-r*(T - t))

elif OptionType == "Digital Call":
    V[-1,:] = np.where(S>=K, 1, 0)
    V[:,0] = 0
    V[:,-1] = np.exp(-r*(T-t))

elif OptionType == "Digital Put":
    V[-1,:] = np.where(S<K, 1, 0)
    V[:,0] = np.exp(-r*(T-t))
    V[:,-1] = 0
    

elif OptionType == "Up and Out Call Option":
    B_up_idx = np.argmin(np.abs(S - B_up))
    V[:, B_up_idx:] = 0
    V[:, 0] = 0
    V[-1, :B_up_idx] = np.maximum(S[:B_up_idx] - K, 0)
    i_min = 1
    i_max = B_up_idx

elif OptionType == "Up and Out Put Option":
    B_up_idx = np.argmin(np.abs(S - B_up))
    V[:, B_up_idx:] = 0
    V[:, 0] = K*np.exp(-r*(T-t))
    V[-1, :B_up_idx] = np.maximum(K - S[:B_up_idx], 0)
    i_min = 1
    i_max = B_up_idx

elif OptionType == "Down and Out Call Option":
    B_down_idx = np.argmin(np.abs(S - B_down))
    V[:, :B_down_idx+1] = 0
    V[:, -1] = S_max - K*np.exp(-r*(T-t))
    V[-1, B_down_idx+1:] = np.maximum(S[B_down_idx+1:] - K, 0)
    i_min = B_down_idx + 1
    i_max = S_nodes - 1

elif OptionType == "Down and Out Put Option":
    B_down_idx = np.argmin(np.abs(S - B_down))
    V[:, :B_down_idx+1] = 0
    V[:, -1] = 0
    V[-1, B_down_idx+1:] = np.maximum(K - S[B_down_idx+1:], 0)
    i_min = B_down_idx + 1
    i_max = S_nodes - 1
            



for j in range(T_nodes-1, 0, -1):
    for i in range(i_min, i_max):
        V[j-1,i] = V[j,i] + dt*(((V[j, i+1] - 2*V[j,i]+V[j,i-1])/(ds**2))*0.5 * ((vol*S[i])**2) + r*S[i]*((V[j,i+1]-V[j,i-1])/(2*ds)) - r*V[j,i] )


def BlackScholesPrices(S_array, K, r, vol, T, t):
    CallPrices = np.zeros(S_array.size)
    PutPrices = np.zeros(S_array.size)
    DigitalCallPrices = np.zeros(S_array.size)
    DigitalPutPrices = np.zeros(S_array.size)
    DigitalPutPrices[0] = np.exp(-r*(T-t))
    PutPrices[0] = K*np.exp(-r*(T-t))
    for i in range(1,S_array.size):
        d1 = (np.log(S_array[i]/K) + (r+(0.5*(vol**2)))*(T-t)) / (vol*np.sqrt(T-t))
        d2 = d1 - vol*np.sqrt(T-t)
        CallPrices[i] = S_array[i]*norm.cdf(d1) - (K*np.exp(-r*(T-t))*norm.cdf(d2))
        PutPrices[i] = -S_array[i]*norm.cdf(-d1) +(K*np.exp(-r*(T-t))*norm.cdf(-d2))
        DigitalCallPrices[i] = np.exp(-r*(T-t)) * norm.cdf(d2)
        DigitalPutPrices[i] = np.exp(-r*(T-t)) * norm.cdf(-d2)
    return CallPrices, PutPrices, DigitalCallPrices, DigitalPutPrices
BS_CallPrices, BS_PutPrices, DigitalCallPrices, DigitalPutPrices = BlackScholesPrices(S, K, r, vol, T, 0)

def BarrierClosedForm(S, K, B, r, vol, T, t, OptionType, BarrierType):

    S = np.asarray(S, dtype=float)
    tau = T - t
    prices = np.zeros_like(S)

    if BarrierType == "Up":
        active = S < B
    else:
        active = S > B

    if tau == 0:
        payoff = (np.maximum(S-K, 0) if OptionType == "Call"
                  else np.maximum(K-S, 0))
        return np.where(active, payoff, 0)


    if BarrierType == "Up" and OptionType == "Put":
        prices[S == 0] = K * np.exp(-r*tau)

    valid = active & (S > 0)
    s = S[valid]

    if s.size == 0:
        return prices

    sigma2 = vol**2
    v = sigma2 * tau
    m = r - sigma2 / 2

    b = np.log(B / s)
    k = np.log(K / s)

    # Integration limits for payoff and surviving paths
    if OptionType == "Call":
        lower = k if BarrierType == "Up" else np.maximum(k, b)
        upper = b if BarrierType == "Up" else np.full_like(b, np.inf)
    else:
        lower = np.full_like(b, -np.inf) if BarrierType == "Up" else b
        upper = np.minimum(k, b) if BarrierType == "Up" else k


    def moment(a, p):
        z_upper = (upper - a - p*v) / np.sqrt(v)
        z_lower = (lower - a - p*v) / np.sqrt(v)

        return np.where(
            upper > lower,
            np.exp(p*a + 0.5*p*p*v) *
            (norm.cdf(z_upper) - norm.cdf(z_lower)),
            0
        )


    a = m * tau
    a_reflected = 2*b + a
    weight = np.exp(2*m*b / sigma2)

    M0 = moment(a, 0) - weight*moment(a_reflected, 0)
    M1 = moment(a, 1) - weight*moment(a_reflected, 1)

    if OptionType == "Call":
        prices[valid] = np.exp(-r*tau) * (s*M1 - K*M0)
    else:
        prices[valid] = np.exp(-r*tau) * (K*M0 - s*M1)

    return np.maximum(prices, 0)

if OptionType == "Put":
    ClosedForm_Prices = BS_PutPrices
elif OptionType =="Call":
    ClosedForm_Prices = BS_CallPrices
elif OptionType == "Digital Call":
    ClosedForm_Prices = DigitalCallPrices
elif OptionType == "Digital Put":
    ClosedForm_Prices = DigitalPutPrices

elif OptionType == "Up and Out Call Option":
    ClosedForm_Prices = BarrierClosedForm(
        S, K, B_up, r, vol, T, 0, "Call", "Up"
    )

elif OptionType == "Up and Out Put Option":
    ClosedForm_Prices = BarrierClosedForm(
        S, K, B_up, r, vol, T, 0, "Put", "Up"
    )

elif OptionType == "Down and Out Call Option":
    ClosedForm_Prices = BarrierClosedForm(
        S, K, B_down, r, vol, T, 0, "Call", "Down"
    )

elif OptionType == "Down and Out Put Option":
    ClosedForm_Prices = BarrierClosedForm(
        S, K, B_down, r, vol, T, 0, "Put", "Down"
    )



plt.figure()
plt.plot(S, V[0, :], label=f"Finite Difference {OptionType}")
plt.plot(S, ClosedForm_Prices, linestyle="--",
