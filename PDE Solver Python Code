BS_Surface = np.zeros_like(V)

for j in range(t.size):

    if j == t.size - 1:

        if OptionType == "Call":
            BS_Surface[j, :] = np.maximum(S-K, 0)

        elif OptionType == "Put":
            BS_Surface[j, :] = np.maximum(K-S, 0)

        elif OptionType == "Digital Call":
            BS_Surface[j, :] = np.where(S >= K, 1, 0)

        elif OptionType == "Digital Put":
            BS_Surface[j, :] = np.where(S < K, 1, 0)

        elif OptionType == "Up and Out Call Option":
            BS_Surface[j, :] = np.where(S < B_up, np.maximum(S-K, 0), 0)

        elif OptionType == "Up and Out Put Option":
            BS_Surface[j, :] = np.where(S < B_up, np.maximum(K-S, 0), 0)

        elif OptionType == "Down and Out Call Option":
            BS_Surface[j, :] = np.where(S > B_down, np.maximum(S-K, 0), 0)

        elif OptionType == "Down and Out Put Option":
            BS_Surface[j, :] = np.where(S > B_down, np.maximum(K-S, 0), 0)

    else:

        CallPrices, PutPrices, DigitalCallPrices, DigitalPutPrices = BlackScholesPrices(
            S, K, r, vol, T, t[j]
        )

        if OptionType == "Call":
            BS_Surface[j, :] = CallPrices

        elif OptionType == "Put":
            BS_Surface[j, :] = PutPrices

        elif OptionType == "Digital Call":
            BS_Surface[j, :] = DigitalCallPrices

        elif OptionType == "Digital Put":
            BS_Surface[j, :] = DigitalPutPrices

        elif OptionType == "Up and Out Call Option":
            BS_Surface[j, :] = BarrierClosedForm(
                S, K, B_up, r, vol, T, t[j], "Call", "Up"
            )

        elif OptionType == "Up and Out Put Option":
            BS_Surface[j, :] = BarrierClosedForm(
                S, K, B_up, r, vol, T, t[j], "Put", "Up"
            )

        elif OptionType == "Down and Out Call Option":
            BS_Surface[j, :] = BarrierClosedForm(
                S, K, B_down, r, vol, T, t[j], "Call", "Down"
            )

        elif OptionType == "Down and Out Put Option":
            BS_Surface[j, :] = BarrierClosedForm(
                S, K, B_down, r, vol, T, t[j], "Put", "Down"
            )

